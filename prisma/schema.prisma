generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  password   String
  role       String   @default("user") // 'admin', 'manager', 'developer', 'designer', 'tester'
  department String? // 'development', 'testing', 'design', 'management', 'marketing'
  status     String   @default("active") // 'active', 'invited', 'inactive'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  projects       Project[]
  projectMembers ProjectMember[]
  aiChatSessions AiChatSession[]
  invitesSent    UserInvite[]    @relation("InvitedBy")
  headOf         Department[]

  @@map("users")
}

model UserInvite {
  id          String    @id @default(cuid())
  email       String    @unique
  role        String    @default("user")
  department  String?
  token       String    @unique
  invitedById String
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@map("user_invites")
}

model Project {
  id                     String    @id @default(cuid())
  name                   String
  description            String?
  phase                  String?
  progress               Float     @default(0)
  teamSize               Int       @default(1)
  priority               String    @default("medium") // 'low', 'medium', 'high', 'critical'
  status                 String    @default("active") // 'active', 'on-hold', 'completed'
  githubUrl              String?
  githubToken            String? // Encrypted GitHub personal access token
  localPath              String?
  startDate              DateTime  @default(now())
  dueDate                DateTime?
  userId                 String
  currentPhase           String? // 'requirements' | 'documentation' | 'architecture' | 'implementation' | 'testing' | 'review'
  architectureApprovedAt DateTime?
  lastWorkflowRunId      String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiChatSessions AiChatSession[]
  memorySummary  ProjectMemorySummary?
  repoSnapshot   ProjectRepoSnapshot?
  decisions      ProjectDecision[]
  rules          ProjectRule[]
  tasks          ProjectTask[]
  files          ProjectFile[]
  documents      ProjectDocument[]
  members        ProjectMember[]
  sprints        Sprint[]
  phaseStates    ProjectPhaseState[]
  phaseArtifacts PhaseArtifact[]
  phaseApprovals PhaseApproval[]
  workflowRuns   WorkflowRun[]
  agentManifests AgentManifest[]
  decompositions TaskDecomposition[]
  kanbanBoard    KanbanBoard?
  repositories   ProjectRepository[]
  contextSnapshots ContextSnapshot[]
  architectureDriftRecords ArchitectureDriftRecord[]

  @@map("projects")
}

// Multi-repository support (Anka OS v2.0 spec §11). A project may span more than
// one source repository (frontend/backend/mobile/infra/...); Project.githubUrl/
// githubToken/localPath remain as the legacy single-repo pointer for backward
// compatibility and are mirrored into one ProjectRepository row (isPrimary=true)
// on migration rather than removed.
model ProjectRepository {
  id           String    @id @default(cuid())
  projectId    String
  name         String // human label, e.g. "frontend", "backend"
  role         String // 'frontend' | 'backend' | 'mobile' | 'infrastructure' | 'shared_library' | 'documentation' | 'data' | 'custom'
  githubUrl    String
  githubToken  String? // encrypted, same AES-256-CBC scheme as Project.githubToken
  localPath    String?
  defaultBranch String   @default("main")
  environments Json? // e.g. { staging: {...}, production: {...} }
  languages    Json? // e.g. ["typescript", "python"]
  frameworks   Json? // e.g. ["next.js", "express"]
  buildCommand String?
  testCommand  String?
  lintCommand  String?
  typecheckCommand String?
  currentIndexedCommit String? // last commit SHA the intelligence layer represents
  ownerUserId  String?
  dependencies Json? // service/package/API/event relationships to other ProjectRepository rows
  executionPolicy Json? // { allowedTools, protectedPaths, riskClass, mergeRules }
  isPrimary    Boolean   @default(false) // true for the repo backfilled from legacy Project fields
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot RepositorySnapshot?

  @@index([projectId])
  @@map("project_repositories")
}

// Per-repository AI context cache (Anka OS v2.0 spec §17.3). Additive and separate
// from ProjectRepoSnapshot on purpose: the legacy single-repo agent path keeps using
// ProjectRepoSnapshot untouched (zero behavior change for existing single-repo
// projects); a non-primary ProjectRepository gets its own row here instead of
// overwriting the project-level snapshot.
model RepositorySnapshot {
  id            String   @id @default(cuid())
  repositoryId  String   @unique
  githubUrl     String
  repoName      String
  defaultBranch String
  description   String   @default("")
  fileTree      String   @db.Text
  languages     String
  keyFiles      String   @db.Text
  lastSyncedAt  DateTime @default(now())

  repository ProjectRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@map("repository_snapshots")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model AiChatSession {
  id        String   @id @default(cuid())
  type      String // 'general' or 'project'
  userId    String
  projectId String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@map("ai_chat_sessions")
}

model AiChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // 'user' or 'assistant'
  content   String
  metadata  Json? // Additional context metadata
  createdAt DateTime @default(now())

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("ai_chat_messages")
}

model ProjectMemorySummary {
  id          String   @id @default(cuid())
  projectId   String   @unique
  summary     String
  lastUpdated DateTime @default(now())
  version     Int      @default(1)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_memory_summaries")
}

model ProjectDecision {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String
  impact      String?
  phase       String? // phase this decision was made in, e.g. 'architecture'
  artifactId  String? // optional link to the PhaseArtifact this decision was recorded against
  madeAt      DateTime @default(now())
  madeBy      String?

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifact PhaseArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  @@map("project_decisions")
}

// ── Phased workflow (Documentation → Architecture → Implementation → Testing) ──

model ProjectPhaseState {
  id           String    @id @default(cuid())
  projectId    String
  phase        String // 'requirements' | 'documentation' | 'architecture' | 'implementation' | 'testing' | 'review'
  status       String    @default("not_started") // 'not_started' | 'in_progress' | 'awaiting_approval' | 'approved' | 'completed'
  startedAt    DateTime?
  completedAt  DateTime?
  approvedById String?
  approvedAt   DateTime?
  notes        String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, phase])
  @@map("project_phase_states")
}

model PhaseArtifact {
  id        String   @id @default(cuid())
  projectId String
  phase     String
  type      String // 'requirements_doc' | 'architecture_doc' | 'decision_log' | 'diagram' | ...
  title     String
  content   String   @db.Text
  version   Int      @default(1)
  createdBy String
  createdAt DateTime @default(now())
  approved  Boolean  @default(false)

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decisions ProjectDecision[]

  @@index([projectId, phase])
  @@map("phase_artifacts")
}

model PhaseApproval {
  id           String   @id @default(cuid())
  projectId    String
  phase        String
  approvedById String
  approvedAt   DateTime @default(now())
  decision     String // 'approved' | 'changes_requested' | 'rejected'
  comments     String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, phase])
  @@map("phase_approvals")
}

model WorkflowRun {
  id           String    @id @default(cuid())
  projectId    String
  triggerType  String // 'manual' | 'auto_advance' | 'retry'
  currentPhase String
  status       String    @default("running") // 'running' | 'completed' | 'failed' | 'cancelled'
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  modelUsage   Json?
  costUSD      Float?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("workflow_runs")
}

model ProjectRule {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String
  priority    String   @default("medium") // 'low', 'medium', 'high'
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_rules")
}

model ProjectTask {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      String    @default("todo")
  priority    String    @default("medium")
  phase       String    @default("development")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments       TaskComment[]
  sprints        SprintTask[]
  blocking       TaskDependency[]    @relation("Blocking")
  blockedBy      TaskDependency[]    @relation("BlockedBy")
  checklistItems TaskChecklistItem[]

  @@map("project_tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  projectId String
  userId    String
  userName  String
  content   String
  createdAt DateTime @default(now())

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

model ProjectActivity {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  userName   String
  action     String // 'created_task', 'updated_task', 'deleted_task', 'moved_task', 'added_comment', 'uploaded_file'
  entityType String // 'task', 'file', 'comment'
  entityId   String?
  entityName String?
  meta       Json? // e.g. { from: 'todo', to: 'in_progress' }
  createdAt  DateTime @default(now())

  @@map("project_activities")
}

model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  type       String   @default("doc") // 'doc', 'image', 'spreadsheet', 'design', 'code', 'other'
  phase      String   @default("development") // 'product-modeling', 'development', 'marketing'
  url        String?
  s3Key      String?
  size       String?
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_files")
}

model ProjectChatMessage {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  userName  String
  content   String
  createdAt DateTime @default(now())

  @@map("project_chat_messages")
}

model TaskDependency {
  id             String   @id @default(cuid())
  blockingTaskId String
  blockedTaskId  String
  projectId      String
  createdAt      DateTime @default(now())

  blockingTask ProjectTask @relation("Blocking", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask  ProjectTask @relation("BlockedBy", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@unique([blockingTaskId, blockedTaskId])
  @@map("task_dependencies")
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String // 'mention', 'comment', 'assignment', 'alert', 'system'
  title      String
  message    String
  link       String?
  read       Boolean  @default(false)
  entityId   String?
  entityType String?
  createdAt  DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model ProjectRepoSnapshot {
  id            String   @id @default(cuid())
  projectId     String   @unique
  githubUrl     String
  repoName      String
  defaultBranch String
  description   String   @default("")
  fileTree      String   @db.Text
  languages     String
  keyFiles      String   @db.Text
  lastSyncedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_repo_snapshots")
}

// Frozen, auditable record of exactly what an agent run saw (Anka OS v2.0 spec §12.5,
// §13 hallucination controls). Purely additive — write-only from runCodingAgent's
// perspective, best-effort (a failed write must never fail the actual agent run).
model ContextSnapshot {
  id                     String   @id @default(cuid())
  projectId              String
  repositoryId           String? // targeted ProjectRepository; null = legacy/primary repo
  sessionId              String
  userMessage            String   @db.Text
  repoUrl                String?
  repoName               String?
  defaultBranch          String?
  repoLastSyncedAt       DateTime?
  keyFilesUsed           Json? // file paths included in this run's context
  approvedArchitectureId String? // PhaseArtifact.id, if an approved architecture doc was in context
  taskType               String?
  risk                   String?
  estimatedComplexity    String?
  targetPaths            Json?
  // Evidence classification for this run's context sources, per spec §13.1
  // (Verified-Repository / Verified-Execution / Approved-Human / Retrieved-History /
  // Inferred-Agent / Unknown). Computed at write time from data already gathered —
  // no new LLM call, purely labeling what runCodingAgent already collected.
  evidenceLabels         Json?
  createdAt              DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sessionId])
  @@map("context_snapshots")
}

// Flags a disagreement between approved architecture and observed repository state
// (spec §12.4). Detection here is a cheap, timestamp-based heuristic run inline in
// runCodingAgent (no extra LLM call) — not full semantic comparison. Records can also
// be created directly (human- or agent-flagged) via the API for a real conflict found
// during other work.
model ArchitectureDriftRecord {
  id                String    @id @default(cuid())
  projectId         String
  description       String    @db.Text
  affectedScope     Json? // e.g. file paths or component names believed affected
  evidence          Json? // e.g. { architectureArtifactId, architectureApprovedAt, repoLastSyncedAt }
  risk              String    @default("medium") // 'low' | 'medium' | 'high' | 'critical'
  proposedResolution String?  @db.Text
  ownerUserId       String?
  status            String    @default("open") // 'open' | 'resolved_code_corrected' | 'resolved_architecture_updated' | 'accepted_exception' | 'dismissed'
  detectedBy        String    @default("heuristic") // 'heuristic' | 'agent' | 'human'
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@map("architecture_drift_records")
}

model Sprint {
  id        String   @id @default(cuid())
  projectId String
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  status    String   @default("planning") // planning, active, completed
  velocity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   SprintTask[]

  @@map("sprints")
}

model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  projectId String
  text      String
  checked   Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_checklist_items")
}

model SprintTask {
  id       String @id @default(cuid())
  sprintId String
  taskId   String

  sprint Sprint      @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task   ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([sprintId, taskId])
  @@map("sprint_tasks")
}

model ProjectDocument {
  id        String   @id @default(cuid())
  projectId String
  title     String
  content   String
  type      String   @default("note") // requirements, documentation, note
  createdBy String   @default("AI Assistant")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_documents")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  headUserId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  head User? @relation(fields: [headUserId], references: [id], onDelete: SetNull)

  @@map("departments")
}

// Canonical role registry (Anka OS v2.0 spec §5.1 Role/PermissionPolicy). User.role
// stays a String column — not a hard FK — so every existing `user.role === 'admin'`
// comparison across both repos keeps working unchanged; this table is what makes
// that string a real, enforced value instead of arbitrary free text: signup/invite/
// user-update now validate role against Role.name, and requireRole() middleware
// gates admin-only routes on it.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())

  @@map("roles")
}

model OrgRule {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String   @default("workflow") // security, workflow, access, notification
  enabled     Boolean  @default(true)
  conditions  Json     @default("[]")
  actions     Json     @default("[]")
  createdBy   String   @default("Admin")
  ruleType    String? // null = policy only; 'sprint_auto_close' | 'overdue_escalation'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("org_rules")
}

// ────────────────────────────────────────────────────────────────────────────
// Agent Manifest and Task Decomposition Models
// ────────────────────────────────────────────────────────────────────────────

model AgentManifest {
  id               String    @id @default(cuid())
  projectId        String
  sessionId        String
  taskId           String? // Optional link to a specific task
  subTaskId        String? // For decomposed tasks
  manifestJson     Json // The complete FileManifest
  validationStatus String // "pending" | "approved" | "rejected"
  validationErrors Json? // Array of ValidationError objects
  generatedAt      DateTime  @default(now())
  approvedAt       DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sessionId])
  @@index([taskId])
  @@map("agent_manifests")
}

model TaskDecomposition {
  id                String    @id @default(cuid())
  projectId         String
  sessionId         String
  parentTaskId      String? // Link to original task if available
  userRequest       String    @db.Text
  graphJson         Json // The complete DependencyExecutionGraph
  totalSubTasks     Int
  completedSubTasks Int       @default(0)
  status            String // "in_progress" | "completed" | "failed"
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subTasksExecs  SubTaskExecution[]

  @@index([projectId, sessionId])
  @@map("task_decompositions")
}

model SubTaskExecution {
  id              String    @id @default(cuid())
  decompositionId String
  subTaskId       String // Maps to SubTask.id from DependencyExecutionGraph
  category        String // SubTaskCategory enum value
  description     String    @db.Text
  targetFiles     Json // Array of file paths
  manifestId      String? // Links to AgentManifest if generated
  status          String // "pending" | "in_progress" | "completed" | "failed"
  executionOrder  Int // Position in topological sort
  startedAt       DateTime?
  completedAt     DateTime?
  errorLog        String?   @db.Text

  decomposition TaskDecomposition @relation(fields: [decompositionId], references: [id], onDelete: Cascade)

  @@index([decompositionId, executionOrder])
  @@index([status])
  @@map("sub_task_executions")
}

// ────────────────────────────────────────────────────────────────────────────
// Kanban & Interactive Clarification Models
// ────────────────────────────────────────────────────────────────────────────

model KanbanBoard {
  id        String        @id @default(cuid())
  projectId String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stages  KanbanStage[]

  @@map("kanban_boards")
}

model KanbanStage {
  id      String       @id @default(cuid())
  boardId String
  title   String
  order   Int          @default(0)

  board KanbanBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks KanbanTask[]

  @@index([boardId, order])
  @@map("kanban_stages")
}

model KanbanTask {
  id                 String   @id @default(cuid())
  stageId            String
  title              String
  description        String   @db.Text
  acceptanceCriteria Json     @default("[]")
  targetFiles        Json     @default("[]")
  status             String   @default("todo") // 'todo' | 'in_progress' | 'needs_clarification' | 'completed' | 'failed'
  order              Int      @default(0)
  executionLogs      String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  stage         KanbanStage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  clarifications ClarificationQA[]

  @@index([stageId, order])
  @@index([status])
  @@map("kanban_tasks")
}

model ClarificationQA {
  id             String    @id @default(cuid())
  taskId         String
  question       String    @db.Text
  options        Json      @default("[]") // Array of string options or { label, value, pros, cons }
  selectedOption String?
  userNotes      String?   @db.Text
  resolved       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  task KanbanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, resolved])
  @@map("clarification_qas")
}

