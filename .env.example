# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/anka_os?schema=public"

# Disposable Test Database (Required for isolated CP0 acceptance and CP1 integration suites)
# Must point to a local non-production PostgreSQL instance (ephemeral schemas will be created and dropped)
# Never point this to a production database.
CP0_TEST_DATABASE_URL="postgresql://username:password@localhost:5432/anka_test?schema=public"

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Encryption for sensitive data (GitHub tokens, etc.)
# Generate a secure 32-character key for production
ENCRYPTION_KEY=your_32_character_encryption_key_here_change_this_in_production

# CORS
FRONTEND_URL=http://localhost:3000

# AWS S3 (Document storage & evidence)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_s3_bucket_name
